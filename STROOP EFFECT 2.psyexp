n': 'incongruent', 'correct': 'g'}, {'word': 'BLUE', 'colors': 'yellow', 'condition': 'incongruent', 'correct': 'y'}, {'word': 'GREEN', 'colors': 'red', 'condition': 'incongruent', 'correct': 'r'}, {'word': 'YELLOW', 'colors': 'blue', 'condition': 'incongruent', 'correct': 'b'}, {'word': 'RED', 'colors': 'yellow', 'condition': 'incongruent', 'correct': 'y'}, {'word': 'BLUE', 'colors': 'green', 'condition': 'incongruent', 'correct': 'g'}, {'word': 'GREEN', 'colors': 'blue', 'condition': 'incongruent', 'correct': 'b'}, {'word': 'YELLOW', 'colors': 'red', 'condition': 'incongruent', 'correct': 'r'}, {'word': 'RED', 'colors': 'green', 'condition': 'incongruent', 'correct': 'g'}, {'word': 'BLUE', 'colors': 'yellow', 'condition': 'incongruent', 'correct': 'y'}, {'word': 'GREEN', 'colors': 'red', 'condition': 'incongruent', 'correct': 'r'}, {'word': 'YELLOW', 'colors': 'blue', 'condition': 'incongruent', 'correct': 'b'}, {'word': 'RED', 'colors': 'blue', 'condition': 'incongruent', 'correct': 'b'}, {'word': 'BLUE', 'colors': 'red', 'condition': 'incongruent', 'correct': 'r'}, {'word': 'GREEN', 'colors': 'yellow', 'condition': 'incongruent', 'correct': 'y'}, {'word': 'YELLOW', 'colors': 'green', 'condition': 'incongruent', 'correct': 'g'}]" valType="str"/>
